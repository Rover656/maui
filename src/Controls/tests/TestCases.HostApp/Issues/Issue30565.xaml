<?xml version="1.0" encoding="UTF-8" ?>
<Shell
  x:Class="Controls.TestCases.HostApp.Issues.Issue30565"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
  xmlns:issues="clr-namespace:Controls.TestCases.HostApp.Issues"
  x:Name="this">

  <Shell.Resources>
    <ResourceDictionary>
      <issues:Issue30565InvertedBoolConverter
        x:Key="InvertedBoolConverter" />
    </ResourceDictionary>
  </Shell.Resources>

  <FlyoutItem
    x:Name="flyout"
    Title="Main"
    Route="Main"
    FlyoutDisplayOptions="AsMultipleItems">
    <ShellContent
      x:Name="HomeTab"
      Title="Home"
      IsVisible="{Binding IsLoggedIn, Source={x:Reference this}}"
      Route="MainPage"
      ContentTemplate="{DataTemplate issues:Issue30565FillerPage}"/>
    <ShellContent
      x:Name="Tab2"
      Title="Page 2"
      IsVisible="{Binding IsLoggedIn, Source={x:Reference this}}"
      Route="AnotherPage"
      ContentTemplate="{DataTemplate issues:Issue30565FillerPage}"/>
    <ShellContent
      x:Name="Tab3"
      Title="Page 3"
      IsVisible="{Binding IsLoggedIn, Source={x:Reference this}}"
      Route="AThirdPage"
      ContentTemplate="{DataTemplate issues:Issue30565FillerPage}" />
    <ShellContent
      x:Name="Tab4"
      Title="Page 4"
      IsVisible="{Binding IsLoggedIn, Source={x:Reference this}}"
      Route="Page4"
      ContentTemplate="{DataTemplate issues:Issue30565FillerPage}" />
    <ShellContent
      x:Name="Tab5"
      Title="Page 5"
      IsVisible="{Binding IsLoggedIn, Source={x:Reference this}}"
      Route="Page5"
      ContentTemplate="{DataTemplate issues:Issue30565LogoutPage}" />
    <ShellContent
      x:Name="LoginTab"
      Title="Login"
      IsVisible="{Binding IsLoggedIn, Source={x:Reference this}, Converter={StaticResource InvertedBoolConverter}}"
      Route="PretendLoginPage"
      ContentTemplate="{DataTemplate issues:Issue30565LoginPage}">
    </ShellContent>
  </FlyoutItem>

</Shell>